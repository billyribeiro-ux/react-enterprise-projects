// Prisma schema for 17-stripe-webhook-engine
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = "file:./dev.db"
}

model StripeOrder {
  id        String   @id @default(cuid())
  amount    Int
  currency  String   @default("usd")
  status    String   @default("succeeded")
  createdAt DateTime @default(now())
}
