// Prisma schema for 10-web-audio-daw
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = "file:./dev.db"
}

model AudioProject {
  id        String       @id @default(cuid())
  title     String
  bpm       Int          @default(128)
  tracks    AudioTrack[]
  createdAt DateTime     @default(now())
}

model AudioTrack {
  id        String       @id @default(cuid())
  projectId String
  project   AudioProject @relation(fields: [projectId], references: [id], onDelete: Cascade)
  name      String
  steps     String
  volume    Float        @default(0.8)
}
