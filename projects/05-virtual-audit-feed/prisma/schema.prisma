// Prisma schema for 05-virtual-audit-feed
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = "file:./dev.db"
}

model SecurityAuditLog {
  id          String   @id @default(cuid())
  actorEmail  String
  actionType  String
  ipAddress   String
  severity    String   @default("info")
  timestamp   DateTime @default(now())

  @@index([timestamp])
}
