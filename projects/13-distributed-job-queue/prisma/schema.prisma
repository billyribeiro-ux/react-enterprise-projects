// Prisma schema for 13-distributed-job-queue
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = "file:./dev.db"
}

model BackgroundJob {
  id          String   @id @default(cuid())
  queueName   String
  status      String   @default("queued")
  attempts    Int      @default(0)
  createdAt   DateTime @default(now())
}
