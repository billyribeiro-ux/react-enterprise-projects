// Prisma schema for 12-ecommerce-ppr-storefront
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = "file:./dev.db"
}

model Product {
  id         String   @id @default(cuid())
  name       String
  priceCents Int
  stockQty   Int      @default(0)
  createdAt  DateTime @default(now())
}
