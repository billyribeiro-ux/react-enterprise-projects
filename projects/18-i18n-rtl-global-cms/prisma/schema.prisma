// Prisma schema for 18-i18n-rtl-global-cms
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = "file:./dev.db"
}

model LocalizedArticle {
  id        String   @id @default(cuid())
  slug      String   @unique
  locale    String
  title     String
  body      String
  createdAt DateTime @default(now())
}
