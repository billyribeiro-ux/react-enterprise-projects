// Prisma schema for 15-resumable-file-vault
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = "file:./dev.db"
}

model VaultFile {
  id         String   @id @default(cuid())
  fileName   String
  fileSize   Int
  sha256Hash String
  status     String   @default("uploading")
  createdAt  DateTime @default(now())
}
