// Prisma schema for 14-svg-analytics-engine
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = "file:./dev.db"
}

model MetricTimeSeries {
  id        String   @id @default(cuid())
  metric    String
  timestamp DateTime
  value     Float
  createdAt DateTime @default(now())

  @@index([metric, timestamp])
}
